ANTHROPIC_API_KEY=sk-ant-...
BROWSERBASE_API_KEY=...
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/autoapply
REDIS_URL=redis://localhost:6379/0
S3_BUCKET=autoapply-screenshots
S3_REGION=us-east-1

# ── Quality gate ──────────────────────────────────────────────────────────────
FIT_THRESHOLD_DEFAULT=70

# ── Vision loop ───────────────────────────────────────────────────────────────
VISION_LOOP_MAX_STEPS=30
VISION_LOOP_WAIT_MS=800
VISION_LOOP_INTER_ACTION_WAIT_MS=200
# Hard ceiling per run — the loop stops into `review` rather than burn past it
VISION_LOOP_TOKEN_BUDGET=150000

# ── Model routing ─────────────────────────────────────────────────────────────
# Vision perceive runs on the cheaper model; a screen whose typed fields mostly
# fail DOM verification retries once on the fallback.
VISION_MODEL=claude-sonnet-5
VISION_FALLBACK_MODEL=claude-opus-5
TAILORING_MODEL=claude-sonnet-5
EXTRACTION_MODEL=claude-haiku-4-5
MAPPING_MODEL=claude-haiku-4-5

# ── Navigation tiers ──────────────────────────────────────────────────────────
# DOM-serialized fill first (one cheap call per form); vision loop as fallback.
# Set false to force every run through the vision loop.
HYBRID_FILL_ENABLED=true

# ── Ops guardrails ────────────────────────────────────────────────────────────
# "local" runs headless Chromium and consumes no Browserbase session minutes
BROWSER_MODE=local
# BROWSER_MODE=browserbase
JD_CACHE_TTL_SECONDS=86400
MAX_DAILY_APPLICATIONS_PER_PLATFORM=20
COST_ALERT_USD=0.50
SCREENSHOT_RETENTION_DAYS=30
