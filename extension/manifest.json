{
  "manifest_version": 3,
  "name": "AutoApply",
  "version": "0.1.0",
  "description": "One-click job application agent",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
